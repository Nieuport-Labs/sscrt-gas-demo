# The gas provider this app talks to. Only ever called when the wallet has no way to pay for gas
# at all — once it holds gas credits it refills itself and this is not used again.
# Must be reachable from the browser (HTTPS in production).
NEXT_PUBLIC_PROVIDER_URL=http://localhost:8787

# Secret Network. Defaults below are mainnet; override for pulsar-3 or a local devnet.
NEXT_PUBLIC_CHAIN_ID=secret-4
NEXT_PUBLIC_LCD_URL=https://lcd-secret.keplr.app
NEXT_PUBLIC_SSCRT_CONTRACT=secret1k0jntykt7e4g3y88ltc60czgjuqdy4c9e8fzek

# The gas-vault contract. It issues fee grants out of its own balance, so a wallet with credits
# pays fees by naming it as granter and never holds SCRT. The default is the secret-4 deployment.
NEXT_PUBLIC_GAS_VAULT_ADDRESS=secret1kkmu4vydkppkhzmx00glm20vn47t09544adv0g

# Refill when credits drop below the floor, up to the target, in uscrt.
#
# The floor is above zero on purpose: the refill transaction pays its own fee out of the credits
# it is topping up, so it has to be affordable before it runs. The target is also the most this
# wallet ever has tied up in the vault, because credits cannot be withdrawn — they only ever
# leave as somebody's gas.
NEXT_PUBLIC_CREDIT_FLOOR_USCRT=5000000
NEXT_PUBLIC_CREDIT_TARGET_USCRT=10000000
